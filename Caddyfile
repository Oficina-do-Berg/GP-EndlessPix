{$DOMAIN} {
	encode zstd gzip

	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
	}

	# Assets do Vite têm hash no nome; podem ficar em cache por muito tempo.
	@hashed-assets path /static/ui/assets/*
	header @hashed-assets Cache-Control "public, max-age=31536000, immutable"

	reverse_proxy app:8000 {
		transport http {
			read_timeout 2h
			write_timeout 2h
		}
	}
}
