# ============================================================
# Produção (VPS com Docker). Veja docs/INSTALACAO.md.
# ============================================================

# Senha de acesso ao site. OBRIGATÓRIO trocar por uma senha longa e única.
APP_PASSWORD=troque-esta-senha

# Chave que assina o cookie de sessão.
# Deixe vazio para o deploy.sh gerar, ou gere com:
#   openssl rand -hex 32
SECRET_KEY=

# Use 1 em produção com HTTPS. Use 0 apenas em teste local via HTTP.
COOKIE_SECURE=0

# Domínio atendido pelo Caddy. Não inclua https://.
# Ex.: fotos.seudominio.com
DOMAIN=fotos.seudominio.com

# ============================================================
# Uploads
# ============================================================

# Limite por arquivo, em MB.
MAX_UPLOAD_MB=4096

# Tempo máximo de cada tentativa de upload, em segundos.
UPLOAD_TIMEOUT_SEC=7200

# Tentativas por arquivo antes de marcar erro.
MAX_RETRIES=3

# 1 = recebe os arquivos e simula o envio (não fala com o Google).
# Use para testar a interface. Depois troque para 0.
DRY_RUN=1

# 1 = confere o SHA-256 dos binários conhecidos do gotohp.
VERIFY_BINARY=1

# Proxy opcional para o gotohp, ex.: http://usuario:senha@host:porta
GOTOHP_PROXY=

# Fuso horário dos logs (opcional). Ex.: America/Sao_Paulo
#TZ=America/Sao_Paulo

# ============================================================
# Caminhos (o Docker Compose já define /data automaticamente)
# ============================================================
#DATA_DIR=data
#TMP_DIR=data/tmp
#DB_PATH=data/app.db
#GOTOHP_CONFIG=data/gotohp.config
#GOTOHP_BIN=bin/gotohp-cli_amd64

# Só para VPS ARM64: binário usado no build da imagem.
#GOTOHP_BUILD_BINARY=bin/gotohp-cli_arm64
